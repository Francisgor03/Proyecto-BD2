# Dirección local de AgroSmart
PORT=3000

# MongoDB. Deja MONGO_URI vacío para probar solo Oracle.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=agrosmart

# Oracle. Descomenta las tres variables de conexión para habilitarlo.
# ORACLE_USER=agrosmart_app
# ORACLE_PASSWORD="tu_clave_local"
# ORACLE_CONNECT_STRING=127.0.0.1:1521/XEPDB1
ORACLE_SCHEMA=AGROSMART_OWNER
